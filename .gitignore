# Generated by XcodeGen — do not commit
*.xcodeproj/
*.xcworkspace/
Sources/App/Info.plist

# Xcode build artifacts
DerivedData/
build/
*.ipa
*.dSYM.zip
*.dSYM

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Swift Package Manager
.build/
.swiftpm/

# fastlane
fastlane/.env.default
fastlane/.env.local
fastlane/report.xml
fastlane/Preview.html
fastlane/README.md
fastlane/test_output/
fastlane/screenshots/**/*.html
.bundle/
vendor/bundle/
# App Review contact details are set once in App Store Connect, never versioned.
# `deliver download_metadata` writes these; keep only notes.txt.
fastlane/metadata/review_information/*
!fastlane/metadata/review_information/notes.txt

# App Store Connect API keys — never commit
*.p8
AuthKey_*.p8

# Xcode user state
xcuserdata/
*.xccheckout
*.moved-aside
